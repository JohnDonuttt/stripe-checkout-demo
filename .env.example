# Copy to .env and fill in. Never commit the real file.

# Secret key from https://dashboard.stripe.com/test/apikeys (use a test key: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by `stripe listen --forward-to localhost:4242/api/webhooks/stripe` (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where the browser app lives. Stripe redirects here after checkout.
# Dev: the Vite server. Production build served by Express: http://localhost:4242
APP_URL=http://localhost:5173

PORT=4242

# SQLite file for orders and processed webhook events
DATABASE_PATH=./data/orders.db
